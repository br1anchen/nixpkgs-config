+    #[test]
+    fn prime_agent_new_session_replaces_exited_generation() {
+        for report_first in [false, true] {
+            let mut terminal = test_terminal();
+            let now = Instant::now();
+            let old =
+                crate::agent_resume::AgentSessionRef::path(test_session_path("old-prime.jsonl"));
+            terminal.set_detected_state(Some(Agent::PrimeAgent), AgentState::Idle);
+            terminal.set_hook_authority_with_session_ref(
+                "herdr:pi".into(),
+                "prime-agent".into(),
+                AgentState::Idle,
+                None,
+                old.clone(),
+                Some(20),
+            );
+            terminal.set_detected_state_with_screen_signals_at(
+                Some(Agent::PrimeAgent),
+                AgentState::Unknown,
+                false,
+                false,
+                false,
+                true,
+                now,
+            );
+            terminal.begin_managed_agent(
+                "sidekick".into(),
+                Agent::PrimeAgent,
+                now,
+                Duration::from_millis(100),
+                Duration::from_secs(1),
+            );
+            let fresh =
+                crate::agent_resume::AgentSessionRef::path(test_session_path("fresh-prime.jsonl"));
+            if !report_first {
+                terminal.set_detected_agent_process_at(
+                    Agent::PrimeAgent,
+                    now + Duration::from_millis(101),
+                );
+            }
+            terminal.set_hook_authority_with_session_ref(
+                "herdr:pi".into(),
+                "prime-agent".into(),
+                AgentState::Idle,
+                None,
+                fresh.clone(),
+                Some(1),
+            );
+            if report_first {
+                assert!(!terminal.full_lifecycle_hook_authority_active());
+                terminal.set_detected_agent_process_at(
+                    Agent::PrimeAgent,
+                    now + Duration::from_millis(101),
+                );
+            }
+            terminal.reconcile_managed_agent_at(now + Duration::from_millis(101), false);
+            assert!(terminal.managed_agent_interactive_ready());
+            assert_eq!(terminal.hook_authority.as_ref().unwrap().session_ref, fresh);
+            terminal.set_hook_authority_with_session_ref(
+                "herdr:pi".into(),
+                "prime-agent".into(),
+                AgentState::Working,
+                None,
+                old,
+                Some(100),
+            );
+            assert_eq!(terminal.state, AgentState::Idle);
+        }
+    }
