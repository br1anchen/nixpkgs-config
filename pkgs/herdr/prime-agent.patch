+    fn prime_agent_reports_drive_readiness_and_release() {
+        let mut terminal = test_terminal();
+        let now = Instant::now();
+        terminal.begin_managed_agent(
+            "sidekick".into(),
+            Agent::PrimeAgent,
+            now,
+            Duration::from_millis(100),
+            Duration::from_secs(1),
+        );
+        terminal.set_detected_state(Some(Agent::PrimeAgent), AgentState::Idle);
+        terminal.reconcile_managed_agent_at(now + Duration::from_millis(101), false);
+        assert!(terminal.managed_agent_launch_pending());
+        assert!(!terminal.managed_agent_interactive_ready());
+        let session = crate::agent_resume::AgentSessionRef::path(test_session_path("prime.jsonl"));
+        terminal.set_hook_authority_with_session_ref(
+            "herdr:pi".into(),
+            "prime-agent".into(),
+            AgentState::Idle,
+            None,
+            session.clone(),
+            Some(1),
+        );
+        terminal.reconcile_managed_agent_at(now + Duration::from_millis(101), false);
+        assert!(terminal.managed_agent_interactive_ready());
+        assert_eq!(terminal.effective_known_agent(), Some(Agent::PrimeAgent));
+        for (seq, state) in [
+            (2, AgentState::Working),
+            (3, AgentState::Blocked),
+            (4, AgentState::Idle),
+        ] {
+            terminal.set_hook_authority_with_session_ref(
+                "herdr:pi".into(),
+                "prime-agent".into(),
+                state,
+                None,
+                session.clone(),
+                Some(seq),
+            );
+            assert_eq!(terminal.state, state);
+        }
+        terminal.set_hook_authority_with_session_ref(
+            "herdr:pi".into(),
+            "prime-agent".into(),
+            AgentState::Working,
+            None,
+            session,
+            Some(2),
+        );
+        assert_eq!(terminal.state, AgentState::Idle);
+        assert!(terminal
