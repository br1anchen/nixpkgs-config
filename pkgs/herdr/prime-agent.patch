+            .is_some());
+        assert!(!terminal.full_lifecycle_hook_authority_active());
+        terminal.set_detected_state_with_screen_signals_at(
+            Some(Agent::PrimeAgent),
+            AgentState::Unknown,
+            false,
+            false,
+            false,
+            true,
+            now + Duration::from_secs(1),
