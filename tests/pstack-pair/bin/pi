#!/usr/bin/env bash
# Fake pi for pair.sh tests: the print-mode preflight. Every call is logged;
# $FAKE/pi-fail holds the error a failing provider prints.
set -u
: "${FAKE:?}"
[ "${1:-}" = --version ] && { printf '1.0.2\n'; exit 0; }
printf '%s\n' "$*" >>"$FAKE/pi.log"
if [ -s "$FAKE/pi-fail" ]; then cat "$FAKE/pi-fail" >&2; exit 1; fi
printf 'OK\n'
