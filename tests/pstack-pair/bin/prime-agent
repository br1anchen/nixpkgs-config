#!/usr/bin/env python3
"""Prime daemon fixture: detaching a client does not stop its session."""
import json
import os
from pathlib import Path
import sys

fake = Path(os.environ['FAKE'])
args = sys.argv[1:]
if args == ['--version']:
    print('0.10.0')
    raise SystemExit(0)
with (fake / 'prime.log').open('a') as log:
    log.write(json.dumps(args) + '\n')
sessions_file = fake / 'prime-sessions.json'
sessions = json.loads(sessions_file.read_text()) if sessions_file.exists() else []

if '--print' in args:
    if (fake / 'prime-fail-once').exists():
        (fake / 'prime-fail-once').unlink()
        print('Error: capacity issues', file=sys.stderr)
        raise SystemExit(1)
    if (fake / 'prime-fail').exists():
        print((fake / 'prime-fail').read_text(), file=sys.stderr)
        raise SystemExit(1)
    print('OK')
elif args[0] == '--fake-start':
    name = args[1]
    counter = fake / 'prime-generation'
    generation = int(counter.read_text()) + 1 if counter.exists() else 1
    counter.write_text(str(generation))
    session_id = f'session-{generation}'
    transcript = fake / 'prime-transcripts' / f'{session_id}.jsonl'
    transcript.parent.mkdir(exist_ok=True)
    transcript.write_text(json.dumps({'type': 'session', 'id': session_id}) + '\n')
    (fake / 'sessions').mkdir(exist_ok=True)
    (fake / 'sessions' / name).write_text(str(transcript))
    sessions.append({'activeSessionId': f'live-{generation}', 'sessionId': session_id,
                     'sessionFile': str(transcript), 'name': name})
    sessions_file.write_text(json.dumps(sessions))
elif args[0] == 'list':
    if (fake / 'prime-list-fail').exists():
        print('daemon unavailable', file=sys.stderr)
        raise SystemExit(1)
    print(json.dumps({'sessions': sessions}))
elif args[0] == 'stop':
    if (fake / 'prime-stop-fail').exists():
        print('stop failed', file=sys.stderr)
        raise SystemExit(1)
    matches = [s for s in sessions if s['activeSessionId'] == args[1]]
    if len(matches) != 1:
        print('unknown active session', file=sys.stderr)
        raise SystemExit(1)
    if not (fake / 'prime-stays-live').exists():
        sessions.remove(matches[0])
        sessions_file.write_text(json.dumps(sessions))
        (fake / 'agents' / matches[0]['name']).unlink(missing_ok=True)
    print('{}')
elif args[0] == 'send':
    if '--steer' in args or '--follow-up' in args:
        print('Unknown option for send', file=sys.stderr)
        raise SystemExit(1)
    target = args[args.index('--json') + 1]
    print(json.dumps({'deliveryMode': 'steer', 'deliveryStatus': 'queued',
                      'target': {'activeSessionId': target}}))
else:
    print(f'unsupported Prime fixture command: {args}', file=sys.stderr)
    raise SystemExit(2)
