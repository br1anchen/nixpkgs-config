#!/usr/bin/env bash
# Fake Muse Code for pair.sh tests: the headless preflight (`muse exec`).
# Every call is logged; $FAKE/muse-fail holds the error a limited or
# logged-out account prints.
set -u
: "${FAKE:?}"
printf '%s\n' "$*" >>"$FAKE/muse.log"
case "${1:-}" in
exec)
	if [ -s "$FAKE/muse-fail" ]; then cat "$FAKE/muse-fail" >&2; exit 1; fi
	printf 'OK\n' ;;
*) printf 'fake muse: unhandled %s\n' "$*" >&2; exit 2 ;;
esac
