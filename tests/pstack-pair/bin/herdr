#!/usr/bin/env bash
# Fake herdr for pair.sh tests. State lives in $FAKE: one file per agent
# (status kind), one per pane. Every call is logged; `agent prompt` runs
# $FAKE/hook NAME TEXT so a scenario can write the files a real agent would.
set -u
: "${FAKE:?}"
mkdir -p "$FAKE/agents" "$FAKE/panes"
printf '%s\n' "$*" >>"$FAKE/calls.log"
# $FAKE/once/<subcommand>: a script run once, at the next `agent <subcommand>`
# call, so a scenario changes state at a set point rather than after a sleep.
if [ "$1" = agent ] && [ -x "$FAKE/once/$2" ]; then
	mv "$FAKE/once/$2" "$FAKE/once/$2.ran"
	"$FAKE/once/$2.ran"
fi
ok() { printf '{"result":{"agent":{"agent_status":"%s","agent":"%s"}}}\n' "$1" "${2:-}"; }
resolve() { if [ -s "$FAKE/panes/$1" ]; then cat "$FAKE/panes/$1"; else printf '%s' "$1"; fi; }
status_of() { [ -f "$FAKE/agents/$1" ] && cut -d' ' -f1 "$FAKE/agents/$1"; }
kind_of() { [ -f "$FAKE/agents/$1" ] && cut -d' ' -f2 "$FAKE/agents/$1"; }
case "$1 $2" in
"agent rename")
	# A pane id starting with "gone" no longer exists, as a stale HERDR_PANE_ID.
	case "$3" in gone*) printf '{"error":{"code":"pane_not_found"}}\n' >&2; exit 1 ;; esac
	# Renaming a live agent keeps its state; Herdr names are unique.
	held="$(cat "$FAKE/panes/$3" 2>/dev/null)"
	if [ -n "$held" ] && [ "$held" != "$4" ] && [ -f "$FAKE/agents/$held" ]; then
		[ ! -f "$FAKE/agents/$4" ] || { printf '{"error":{"code":"name_taken"}}\n' >&2; exit 1; }
		mv "$FAKE/agents/$held" "$FAKE/agents/$4"
		[ ! -s "$FAKE/session-ids/$held" ] || mv "$FAKE/session-ids/$held" "$FAKE/session-ids/$4"
	else printf 'idle claude\n' >"$FAKE/agents/$4"; fi
	printf '%s' "$4" >"$FAKE/panes/$3"; ok idle claude ;;
"agent get")
	n="$(resolve "$3")"; s="$(status_of "$n")" || { printf '{"error":{"code":"not_found"}}\n' >&2; exit 1; }
	# $FAKE/sessions/<name>: the agent's session log path, as herdr reports pi's.
	# The pane that hosts the agent, as real herdr reports it, is the one file under panes/ naming it.
	pid="$(grep -lxF "$n" "$FAKE"/panes/* 2>/dev/null | head -1 | xargs -r basename)"
	# $FAKE/session-ids/<name>: "<id> <cwd>", as herdr reports a Claude session.
	if [ -s "$FAKE/session-ids/$n" ]; then
		read -r sid scwd <"$FAKE/session-ids/$n"
		printf '{"result":{"agent":{"agent_status":"%s","agent":"claude","name":"%s","pane_id":"%s","cwd":"%s","agent_session":{"kind":"id","source":"herdr:claude","value":"%s"}}}}\n' "$s" "$n" "$pid" "$scwd" "$sid"
	elif [ -s "$FAKE/sessions/$n" ]; then
		printf '{"result":{"agent":{"agent_status":"%s","agent":"%s","name":"%s","pane_id":"%s","agent_session":{"kind":"path","value":"%s"}}}}\n' "$s" "$(kind_of "$n")" "$n" "$pid" "$(cat "$FAKE/sessions/$n")"
	else printf '{"result":{"agent":{"agent_status":"%s","agent":"%s","name":"%s","pane_id":"%s"}}}\n' "$s" "$(kind_of "$n")" "$n" "$pid"; fi ;;
"agent start")
	name="$3"; kind=""; shift 3
	while [ $# -gt 0 ]; do case "$1" in --kind) kind="$2"; shift 2 ;; --pane) printf '%s' "$name" >"$FAKE/panes/$2"; shift 2 ;; --) break ;; *) shift ;; esac; done
	# $FAKE/start-busy-once: the pane is still settling after its split, once.
	if [ -e "$FAKE/start-busy-once" ]; then
		rm -f "$FAKE/start-busy-once"
		printf '{"error":{"code":"agent_pane_busy"}}\n' >&2; exit 1
	fi
	# $FAKE/start-fail: herdr refuses the start for a reason of its own.
	if [ -e "$FAKE/start-fail" ]; then
		printf '{"error":{"code":"agent_start_failed","message":"shell not ready"}}\n' >&2; exit 1
	fi
	# $FAKE/trust-dialog: the agent opens on a folder-trust dialog.
	if [ -e "$FAKE/trust-dialog" ]; then
		printf '{"error":{"code":"agent_not_ready","message":"blocked during startup"}}\n' >&2; exit 1
	fi
	[ "$kind" != prime-agent ] || prime-agent --fake-start "$name" "${@:2}"
	printf 'idle %s\n' "$kind" >"$FAKE/agents/$name"; ok idle "$kind" ;;
"agent prompt")
	name="$3"; text="$4"; wait=0; until=""; shift 4
	# $FAKE/exit-dialog/<name>: Claude asks about its background work; option 1
	# then Enter exits. $FAKE/exit-not-ready/<name>: the pane is already back
	# at its shell, so herdr refuses the prompt and then drops the agent.
	if { [ "$text" = /exit ] || [ "$text" = /quit ]; } && [ -e "$FAKE/exit-not-ready/$name" ]; then
		rm -f "$FAKE/agents/$name" "$FAKE/exit-not-ready/$name"
		printf '{"error":{"code":"agent_not_ready","message":"no longer the pane foreground process"}}\n' >&2; exit 1
	fi
	if { [ "$text" = /exit ] || [ "$text" = /quit ]; } && [ -e "$FAKE/exit-dialog/$name" ]; then
		mkdir -p "$FAKE/screen"; printf 'Background work is running\n❯ 1. Exit and stop tasks\n  2. Cancel\n' >"$FAKE/screen/$name"
		printf '{}\n'; exit 0
	fi
	if [ "$text" = /exit ] || [ "$text" = /quit ]; then rm -f "$FAKE/agents/$name"; printf '{}\n'; exit 0; fi
	# $FAKE/prompt-fail: delivery fails.
	[ -e "$FAKE/prompt-fail" ] && { printf '{"error":{"code":"prompt_failed"}}\n' >&2; exit 1; }
	while [ $# -gt 0 ]; do case "$1" in --wait) wait=1; shift ;; --until) until="$until $2"; shift 2 ;; *) shift ;; esac; done
	s="$(status_of "$name")"
	# $FAKE/devin-input: a working Devin leaves a prompt typed in its input
	# box; one Enter queues it, the next sends it (see agent send-keys).
	if [ -e "$FAKE/devin-input" ] && [ "$s" = working ]; then
		mkdir -p "$FAKE/typing"; printf '%s' "$text" >"$FAKE/typing/$name"; ok "$s"; exit 0
	fi
	# $FAKE/prompt-delay: delivery takes that many seconds.
	[ -s "$FAKE/prompt-delay" ] && sleep "$(cat "$FAKE/prompt-delay")"
	# $FAKE/typed-ok: the prompt is typed but not submitted, yet herdr reports
	# success (a fresh Claude pane); one Enter submits it.
	if [ -e "$FAKE/typed-ok" ] && [ "$wait" = 1 ]; then
		rm -f "$FAKE/typed-ok"; mkdir -p "$FAKE/stalled"; printf '%s' "$text" >"$FAKE/stalled/$name"
		ok "$s"; exit 0
	fi
	# $FAKE/prompt-drop: a startup screen swallowed the prompt: nothing typed,
	# nothing run, herdr reports a stall once. The file's text, if any, sets
	# the agent's state (blocked: a dialog is up).
	if [ -e "$FAKE/prompt-drop" ] && [ "$wait" = 1 ]; then
		st="$(cat "$FAKE/prompt-drop")"; rm -f "$FAKE/prompt-drop"
		[ -z "$st" ] || printf '%s %s\n' "$st" "$(kind_of "$name")" >"$FAKE/agents/$name"
		printf '{"error":{"code":"agent_prompt_stalled"}}\n' >&2; exit 1
	fi
	# $FAKE/stall: the prompt is typed but not submitted (a first-run screen
	# took the Enter); herdr reports a stall and one Enter submits it.
	if [ -e "$FAKE/stall" ] && [ "$wait" = 1 ]; then
		rm -f "$FAKE/stall"; mkdir -p "$FAKE/stalled"; printf '%s' "$text" >"$FAKE/stalled/$name"
		printf '{"error":{"code":"agent_prompt_stalled"}}\n' >&2; exit 1
	fi
	[ -x "$FAKE/hook" ] && "$FAKE/hook" "$name" "$text"
	if [ "$wait" = 1 ] && [ -n "$until" ]; then
		# --until working after a quick turn: the state was never observed.
		case " $until " in *" $s "*) ok "$s" ;; *) printf '{"error":{"code":"timeout"}}\n' >&2; exit 1 ;; esac
	elif [ "$wait" = 1 ] && [ "$s" = working ]; then printf '{"error":{"code":"timeout"}}\n' >&2; exit 1
	else ok "$s"; fi ;;
"agent wait")
	s="$(status_of "$3")"
	# A lie: herdr reports a settle while the agent still works, as Devin's
	# done-to-idle flip on a new prompt does. $FAKE/lies counts them down.
	if [ "$s" = working ] && [ -s "$FAKE/lies" ] && [ "$(cat "$FAKE/lies")" -gt 0 ]; then
		echo $(( $(cat "$FAKE/lies") - 1 )) >"$FAKE/lies"; ok idle; exit 0
	fi
	# $FAKE/report-after "N path [status]": the agent finishes on the Nth wait
	# call, with a report of that status (done by default).
	if [ -s "$FAKE/report-after" ]; then
		read -r n path rstatus <"$FAKE/report-after"
		if [ "$n" -le 1 ]; then
			printf '# Report\n\nstatus: %s\n' "${rstatus:-done}" >"$path"; rm -f "$FAKE/report-after"
			printf 'idle devin\n' >"$FAKE/agents/$3"; ok idle; exit 0
		fi
		printf '%s %s %s\n' $((n - 1)) "$path" "${rstatus:-}" >"$FAKE/report-after"
	fi
	if [ "$s" = working ]; then sleep 0.2; printf '{"error":{"code":"timeout"}}\n' >&2; exit 1; fi
	ok "$s" ;;
"agent send-keys")
	if [ -e "$FAKE/exit-dialog/$3" ] && [ -s "$FAKE/screen/$3" ]; then
		case "${4:-}" in
		1) touch "$FAKE/exit-dialog/$3.chose1" ;;
		enter) [ ! -e "$FAKE/exit-dialog/$3.chose1" ] || rm -f "$FAKE/agents/$3" "$FAKE/screen/$3" "$FAKE/exit-dialog/$3" "$FAKE/exit-dialog/$3.chose1" ;;
		esac
		printf '{}\n'; exit 0
	fi
	if [ "${4:-}" = ctrl+d ] && [ "$(kind_of "$3")" = prime-agent ]; then
		rm -f "$FAKE/agents/$3"; printf '{}\n'; exit 0
	fi
	if [ "${4:-}" = enter ] && [ -s "$FAKE/stalled/$3" ]; then
		text="$(cat "$FAKE/stalled/$3")"; rm -f "$FAKE/stalled/$3"
		[ -x "$FAKE/hook" ] && "$FAKE/hook" "$3" "$text"
	elif [ "${4:-}" = enter ] && [ -s "$FAKE/typing/$3" ]; then
		mkdir -p "$FAKE/queued"; mv "$FAKE/typing/$3" "$FAKE/queued/$3"
	elif [ "${4:-}" = enter ] && [ -s "$FAKE/queued/$3" ]; then
		text="$(cat "$FAKE/queued/$3")"; rm -f "$FAKE/queued/$3"
		[ -x "$FAKE/hook" ] && "$FAKE/hook" "$3" "$text"
	fi
	ok "$(status_of "$3")" ;;
"agent read")
	# $FAKE/screen/<name>: the pane shows exactly that text.
	# $FAKE/busy/<name>: the pane shows a working agent whatever herdr's state says.
	# The hint wraps, as it does in a 28-column Devin pane.
	# Devin's input: a queued block (with the send-now hint) above the input
	# box, which holds typed text or, when only the queue is left, the prompt
	# to send it.
	if [ -s "$FAKE/typing/$3" ] || [ -s "$FAKE/queued/$3" ]; then
		[ -s "$FAKE/queued/$3" ] && printf '── 1 ↑ edit · ↵ send now ──\n○ %s\n' "$(cat "$FAKE/queued/$3")"
		if [ -s "$FAKE/typing/$3" ]; then printf '❭ %s\n' "$(cat "$FAKE/typing/$3")"; else printf '❭ Press Enter to send\n  queued messages now\n'; fi
	elif [ -s "$FAKE/stalled/$3" ]; then printf '❯ %s\n' "$(cat "$FAKE/stalled/$3")"
	elif [ -s "$FAKE/screen/$3" ]; then cat "$FAKE/screen/$3"
	elif [ -e "$FAKE/busy/$3" ]; then printf 'Thinking · 7m 52s (esc\n  twice to interrupt)\n'
	elif [ -e "$FAKE/busy-guide/$3" ]; then printf '❭ Guide Devin while it\n  works\n'
	elif [ -e "$FAKE/busy-queue/$3" ]; then printf '── 1 ↑ edit · ↵ send now ──\n○ pstack-trio STOP\n❭ Press Enter to send\n  queued messages now\n'
	else printf 'pane text\n'; fi ;;
"pane split") n=$(ls "$FAKE/panes" | wc -l | tr -d " "); : >"$FAKE/panes/p$n"; printf '{"result":{"pane":{"pane_id":"p%s"}}}\n' "$n" ;;
"pane get") [ -f "$FAKE/panes/$3" ] || exit 1; printf '{"result":{}}\n' ;;
"pane process-info")
	[ -f "$FAKE/panes/$4" ] || exit 1
	pgid=100; [ ! -e "$FAKE/prime-client-stays" ] || pgid=200
	# $FAKE/agent-pid/<pane>: the agent process herdr names in the foreground.
	fg='[]'; [ ! -s "$FAKE/agent-pid/$4" ] || fg="[{\"pid\":$(cat "$FAKE/agent-pid/$4")}]"
	printf '{"result":{"process_info":{"shell_pid":100,"foreground_process_group_id":%s,"foreground_processes":%s}}}\n' "$pgid" "$fg" ;;
"pane close")
	# Closing a pane ends the agent in it.
	held="$(cat "$FAKE/panes/$3" 2>/dev/null)"
	[ -z "$held" ] || rm -f "$FAKE/agents/$held"
	rm -f "$FAKE/panes/$3"; printf '{"result":{"type":"ok"}}\n' ;;
"tab create") n=$(ls "$FAKE/panes" | wc -l | tr -d " "); : >"$FAKE/panes/t$n"; printf '{"result":{"type":"tab_created","tab":{"tab_id":"tab%s"},"root_pane":{"pane_id":"t%s"}}}\n' "$n" "$n" ;;
"pane read")
	if [ -e "$FAKE/trust-dialog" ]; then printf ' Quick safety check: Is this a project you created or one you\n trust?\n ❯ No, exit\n'
	else printf 'pane text\n'; fi ;;
"pane send-keys") printf '{"result":{"type":"ok"}}\n' ;;
"pane layout") pane="$4"; printf '{"result":{"layout":{"panes":[{"pane_id":"%s","rect":{"width":200,"height":50}}]}}}\n' "$pane" ;;
"notification show") printf '{}\n' ;;
*) printf 'fake herdr: unhandled %s\n' "$*" >&2; exit 2 ;;
esac
