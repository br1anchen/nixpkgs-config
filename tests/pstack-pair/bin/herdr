#!/usr/bin/env bash
# Fake herdr for pair.sh tests. State lives in $FAKE: one file per agent
# (status kind), one per pane. Every call is logged; `agent prompt` runs
# $FAKE/hook NAME TEXT so a scenario can write the files a real agent would.
set -u
: "${FAKE:?}"
mkdir -p "$FAKE/agents" "$FAKE/panes"
printf '%s\n' "$*" >>"$FAKE/calls.log"
ok() { printf '{"result":{"agent":{"agent_status":"%s","agent":"%s"}}}\n' "$1" "${2:-}"; }
resolve() { if [ -s "$FAKE/panes/$1" ]; then cat "$FAKE/panes/$1"; else printf '%s' "$1"; fi; }
status_of() { [ -f "$FAKE/agents/$1" ] && cut -d' ' -f1 "$FAKE/agents/$1"; }
kind_of() { [ -f "$FAKE/agents/$1" ] && cut -d' ' -f2 "$FAKE/agents/$1"; }
case "$1 $2" in
"agent rename")
	# A pane id starting with "gone" no longer exists, as a stale HERDR_PANE_ID.
	case "$3" in gone*) printf '{"error":{"code":"pane_not_found"}}\n' >&2; exit 1 ;; esac
	printf 'idle claude\n' >"$FAKE/agents/$4"; printf '%s' "$4" >"$FAKE/panes/$3"; ok idle claude ;;
"agent get")
	n="$(resolve "$3")"; s="$(status_of "$n")" || { printf '{"error":{"code":"not_found"}}\n' >&2; exit 1; }
	ok "$s" "$(kind_of "$n")" ;;
"agent start")
	name="$3"; kind=""; shift 3
	while [ $# -gt 0 ]; do case "$1" in --kind) kind="$2"; shift 2 ;; --pane) printf '%s' "$name" >"$FAKE/panes/$2"; shift 2 ;; --) break ;; *) shift ;; esac; done
	# $FAKE/trust-dialog: the agent opens on a folder-trust dialog.
	if [ -e "$FAKE/trust-dialog" ]; then
		printf '{"error":{"code":"agent_not_ready","message":"blocked during startup"}}\n' >&2; exit 1
	fi
	printf 'idle %s\n' "$kind" >"$FAKE/agents/$name"; ok idle "$kind" ;;
"agent prompt")
	name="$3"; text="$4"; wait=0; until=""; shift 4
	if [ "$text" = /exit ] || [ "$text" = /quit ]; then rm -f "$FAKE/agents/$name"; printf '{}\n'; exit 0; fi
	while [ $# -gt 0 ]; do case "$1" in --wait) wait=1; shift ;; --until) until="$until $2"; shift 2 ;; *) shift ;; esac; done
	s="$(status_of "$name")"
	# $FAKE/devin-input: a working Devin leaves a prompt typed in its input
	# box; one Enter queues it, the next sends it (see agent send-keys).
	if [ -e "$FAKE/devin-input" ] && [ "$s" = working ]; then
		mkdir -p "$FAKE/typing"; printf '%s' "$text" >"$FAKE/typing/$name"; ok "$s"; exit 0
	fi
	# $FAKE/stall: the prompt is typed but not submitted (a first-run screen
	# took the Enter); herdr reports a stall and one Enter submits it.
	if [ -e "$FAKE/stall" ] && [ "$wait" = 1 ]; then
		rm -f "$FAKE/stall"; mkdir -p "$FAKE/stalled"; printf '%s' "$text" >"$FAKE/stalled/$name"
		printf '{"error":{"code":"agent_prompt_stalled"}}\n' >&2; exit 1
	fi
	[ -x "$FAKE/hook" ] && "$FAKE/hook" "$name" "$text"
	if [ "$wait" = 1 ] && [ -n "$until" ]; then
		# --until working after a quick turn: the state was never observed.
		case " $until " in *" $s "*) ok "$s" ;; *) printf '{"error":{"code":"timeout"}}\n' >&2; exit 1 ;; esac
	elif [ "$wait" = 1 ] && [ "$s" = working ]; then printf '{"error":{"code":"timeout"}}\n' >&2; exit 1
	else ok "$s"; fi ;;
"agent wait")
	s="$(status_of "$3")"
	# A lie: herdr reports a settle while the agent still works, as Devin's
	# done-to-idle flip on a new prompt does. $FAKE/lies counts them down.
	if [ "$s" = working ] && [ -s "$FAKE/lies" ] && [ "$(cat "$FAKE/lies")" -gt 0 ]; then
		echo $(( $(cat "$FAKE/lies") - 1 )) >"$FAKE/lies"; ok idle; exit 0
	fi
	# $FAKE/report-after "N path": the agent finishes on the Nth wait call.
	if [ -s "$FAKE/report-after" ]; then
		read -r n path <"$FAKE/report-after"
		if [ "$n" -le 1 ]; then
			printf '# Report\n\nstatus: done\n' >"$path"; rm -f "$FAKE/report-after"
			printf 'idle devin\n' >"$FAKE/agents/$3"; ok idle; exit 0
		fi
		printf '%s %s\n' $((n - 1)) "$path" >"$FAKE/report-after"
	fi
	if [ "$s" = working ]; then sleep 0.2; printf '{"error":{"code":"timeout"}}\n' >&2; exit 1; fi
	ok "$s" ;;
"agent send-keys")
	if [ "${4:-}" = enter ] && [ -s "$FAKE/stalled/$3" ]; then
		text="$(cat "$FAKE/stalled/$3")"; rm -f "$FAKE/stalled/$3"
		[ -x "$FAKE/hook" ] && "$FAKE/hook" "$3" "$text"
	elif [ "${4:-}" = enter ] && [ -s "$FAKE/typing/$3" ]; then
		mkdir -p "$FAKE/queued"; mv "$FAKE/typing/$3" "$FAKE/queued/$3"
	elif [ "${4:-}" = enter ] && [ -s "$FAKE/queued/$3" ]; then
		text="$(cat "$FAKE/queued/$3")"; rm -f "$FAKE/queued/$3"
		[ -x "$FAKE/hook" ] && "$FAKE/hook" "$3" "$text"
	fi
	ok "$(status_of "$3")" ;;
"agent read")
	# $FAKE/screen/<name>: the pane shows exactly that text.
	# $FAKE/busy/<name>: the pane shows a working agent whatever herdr's state says.
	# The hint wraps, as it does in a 28-column Devin pane.
	# Devin's input: a queued block (with the send-now hint) above the input
	# box, which holds typed text or, when only the queue is left, the prompt
	# to send it.
	if [ -s "$FAKE/typing/$3" ] || [ -s "$FAKE/queued/$3" ]; then
		[ -s "$FAKE/queued/$3" ] && printf '── 1 ↑ edit · ↵ send now ──\n○ %s\n' "$(cat "$FAKE/queued/$3")"
		if [ -s "$FAKE/typing/$3" ]; then printf '❭ %s\n' "$(cat "$FAKE/typing/$3")"; else printf '❭ Press Enter to send\n  queued messages now\n'; fi
	elif [ -s "$FAKE/stalled/$3" ]; then printf '❯ %s\n' "$(cat "$FAKE/stalled/$3")"
	elif [ -s "$FAKE/screen/$3" ]; then cat "$FAKE/screen/$3"
	elif [ -e "$FAKE/busy/$3" ]; then printf 'Thinking · 7m 52s (esc\n  twice to interrupt)\n'
	elif [ -e "$FAKE/busy-guide/$3" ]; then printf '❭ Guide Devin while it\n  works\n'
	elif [ -e "$FAKE/busy-queue/$3" ]; then printf '── 1 ↑ edit · ↵ send now ──\n○ pstack-trio STOP\n❭ Press Enter to send\n  queued messages now\n'
	else printf 'pane text\n'; fi ;;
"pane split") n=$(ls "$FAKE/panes" | wc -l); : >"$FAKE/panes/p$n"; printf '{"result":{"pane":{"pane_id":"p%s"}}}\n' "$n" ;;
"pane get") [ -f "$FAKE/panes/$3" ] || exit 1; printf '{"result":{}}\n' ;;
"pane close") rm -f "$FAKE/panes/$3"; printf '{"result":{"type":"ok"}}\n' ;;
"tab create") n=$(ls "$FAKE/panes" | wc -l); : >"$FAKE/panes/t$n"; printf '{"result":{"type":"tab_created","tab":{"tab_id":"tab%s"},"root_pane":{"pane_id":"t%s"}}}\n' "$n" "$n" ;;
"pane read")
	if [ -e "$FAKE/trust-dialog" ]; then printf ' Quick safety check: Is this a project you created or one you\n trust?\n ❯ No, exit\n'
	else printf 'pane text\n'; fi ;;
"pane send-keys") printf '{"result":{"type":"ok"}}\n' ;;
"pane layout") pane="$4"; printf '{"result":{"layout":{"panes":[{"pane_id":"%s","rect":{"width":200,"height":50}}]}}}\n' "$pane" ;;
"notification show") printf '{}\n' ;;
*) printf 'fake herdr: unhandled %s\n' "$*" >&2; exit 2 ;;
esac
